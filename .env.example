# The Lenny Growth Assistant - Environment Configuration

# Database Configuration
# Local SQLite Default (Zero External Dependencies):
DATABASE_URL=sqlite:///./lenny_assistant.db

# Docker / Production PostgreSQL + pgvector:
# DATABASE_URL=postgresql+asyncpg://lenny_user:lenny_password_dev@localhost:5432/lenny_assistant

# LLM Provider Selection (Options: 'mock', 'ollama', 'anthropic', 'openai')
DEFAULT_PROVIDER=mock

# Local Ollama Inference (Mandatory for Local LLM Demo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Cloud Providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
